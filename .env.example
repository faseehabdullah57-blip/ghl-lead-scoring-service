# GoHighLevel (GHL API v2) Credentials & Configuration
# Leave GHL_API_KEY blank or set GHL_DRY_RUN=true for local dry-run/mock testing
GHL_API_KEY=
GHL_API_BASE_URL=https://services.leadconnectorhq.com
GHL_LOCATION_ID=loc_your_subaccount_id
GHL_LEAD_SCORE_FIELD_ID=lead_score
GHL_PRIORITY_STAGE_ID=stage_priority_outreach

# Optional Webhook Security Secret (checked against X-GHL-Signature / X-Webhook-Secret header)
GHL_WEBHOOK_SECRET=

# Operational Flags
GHL_DRY_RUN=true
LOG_LEVEL=INFO

# Optional JSON string to override default scoring rule points or register custom rules
# Example: {"Booked Appointment": 25, "Attended Webinar": 10}
SCORING_RULE_OVERRIDES=
